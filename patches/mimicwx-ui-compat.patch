+// Refuse empty or unrelated accessibility rectangles before injecting input.
+pub fn input_center(window: [i32; 4], candidate: Option<[i32; 4]>) -> Option<(i32, i32)> {
+    let [x, y, w, h] = window.map(i64::from);
+    if x < 0 || y < 0 || w < 200 || h < 220 || x + w > i32::MAX as i64 || y + h > i32::MAX as i64 {
+        return None;
+    }
+    if let Some(candidate) = candidate {
+        let [ex, ey, ew, eh] = candidate.map(i64::from);
+        if ew >= 20 && eh >= 20 && ex >= x && ey >= y + h / 2 && ex + ew <= x + w && ey + eh <= y + h {
+            return Some(((ex + ew / 2) as i32, (ey + eh / 2) as i32));
+        }
+    }
+    Some(((x + w / 2) as i32, (y + h - 100) as i32))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::input_center;
+    const WINDOW: [i32; 4] = [340, 40, 600, 640];
+
+    #[test]
+    fn valid_editor_uses_its_center() {
+        assert_eq!(input_center(WINDOW, Some([350, 550, 580, 90])), Some((640, 595)));
+    }
+    #[test]
+    fn empty_or_header_nodes_use_the_editor_area() {
+        for node in [[0, 0, 0, 0], [350, 45, 120, 30], [-2147483648, 0, 0, 0], [0, 0, 100, 80]] {
+            assert_eq!(input_center(WINDOW, Some(node)), Some((640, 580)));
+        }
+    }
+    #[test]
+    fn absent_editor_uses_the_editor_area() {
+        assert_eq!(input_center(WINDOW, None), Some((640, 580)));
+    }
+    #[test]
+    fn missing_or_offscreen_windows_are_rejected() {
+        for window in [[0, 0, 0, 0], [-200, 0, 600, 640], [0, 0, 600, 100], [i32::MAX, 0, 600, 640]] {
+            assert_eq!(input_center(window, None), None);
+        }
+    }
+}
