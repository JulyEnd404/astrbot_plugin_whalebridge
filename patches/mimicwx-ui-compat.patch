+//! Track visible message identity, not the number of virtualized list rows.
+use std::collections::{HashSet, VecDeque};
+use std::hash::{Hash, Hasher};
+
+pub fn message_id(bus: &str, path: &str, content: &str) -> String {
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    (bus, path, content).hash(&mut hasher);
+    format!("ui:{:016x}", hasher.finish())
+}
+
+#[derive(Default)]
+pub struct UiMessageCursor {
+    initialized: bool,
+    seen: HashSet<String>,
+    order: VecDeque<String>,
+}
+
+impl UiMessageCursor {
+    fn remember(&mut self, id: &str) -> bool {
+        if !self.seen.insert(id.to_string()) { return false; }
+        self.order.push_back(id.to_string());
+        while self.order.len() > 4096 {
+            if let Some(old) = self.order.pop_front() { self.seen.remove(&old); }
+        }
+        true
+    }
+
+    pub fn prime(&mut self, ids: &[String]) {
+        for id in ids { self.remember(id); }
+        self.initialized = true;
+    }
+
+    pub fn unseen(&mut self, ids: &[String]) -> Vec<usize> {
+        if !self.initialized {
+            self.prime(ids);
+            return Vec::new();
+        }
+        ids.iter().enumerate().filter_map(|(i, id)| self.remember(id).then_some(i)).collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn ids(values: &[&str]) -> Vec<String> { values.iter().map(|x| x.to_string()).collect() }
+
+    #[test]
+    fn startup_does_not_replay_history() {
+        let mut c = UiMessageCursor::default();
+        assert!(c.unseen(&ids(&["old1", "old2"])).is_empty());
+        assert_eq!(c.unseen(&ids(&["old1", "old2", "new"])), vec![2]);
+    }
+    #[test]
+    fn same_count_new_tail_is_detected() {
+        let mut c = UiMessageCursor::default();
+        c.prime(&ids(&["a", "b", "c"]));
+        assert_eq!(c.unseen(&ids(&["b", "c", "d"])), vec![2]);
+    }
+    #[test]
+    fn smaller_list_still_detects_new_messages() {
+        let mut c = UiMessageCursor::default();
+        c.prime(&ids(&["a", "b", "c", "d", "e", "f"]));
+        assert_eq!(c.unseen(&ids(&["reply", "time", "command"])), vec![0, 1, 2]);
+    }
+    #[test]
+    fn scrolled_known_rows_and_repeated_polls_are_not_new() {
+        let mut c = UiMessageCursor::default();
+        c.prime(&ids(&["a", "b", "c"]));
+        assert!(c.unseen(&ids(&["b", "c"])).is_empty());
+        assert!(c.unseen(&ids(&["a", "b", "c"])).is_empty());
+    }
+    #[test]
+    fn identity_survives_position_change_but_allows_repeated_text() {
+        let first = message_id(":1.1", "/message1", "合成重复文本");
+        let repeat = message_id(":1.1", "/message2", "合成重复文本");
+        let mut c = UiMessageCursor::default();
+        c.prime(&[first.clone()]);
+        assert!(c.unseen(&[first.clone()]).is_empty());
+        assert_eq!(c.unseen(&[first, repeat]), vec![1]);
+    }
+    #[test]
+    fn reused_accessible_node_with_changed_content_is_new() {
+        assert_ne!(message_id("bus", "/row", "old"), message_id("bus", "/row", "new"));
+    }
+    #[test]
+    fn cursor_storage_is_bounded() {
+        let mut c = UiMessageCursor::default();
+        c.prime(&(0..5000).map(|i| i.to_string()).collect::<Vec<_>>());
+        assert_eq!(c.seen.len(), 4096);
+        assert_eq!(c.order.len(), 4096);
+    }
+}
